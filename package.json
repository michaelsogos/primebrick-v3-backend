{
  "name": "primebrick-api",
  "version": "3.0.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:kill": "node scripts/kill-port-3001.mjs",
    "version:auto": "node scripts/version-sync.mjs",
    "prebuild": "node scripts/version-sync.mjs && pnpm check:standards && pnpm db:check",
    "build": "tsc",
    "test": "pnpm check:standards && vitest run",
    "test:watch": "vitest",
    "prestart": "pnpm run build",
    "start": "node dist/index.js",
    "db:meta:compare": "tsx scripts/database-patch-compare.ts",
    "db:migrate": "tsx scripts/database-patch-apply.ts",
    "db:truncate:customers": "tsx scripts/truncate-customers.ts",
    "db:seed:customers": "tsx scripts/seed-customers.ts",
    "setup:casdoor": "tsx scripts/setup-casdoor.ts",
    "generate:docs": "tsx scripts/generate-docs-pack.ts",
    "check:standards": "bun ../primebrick-v3-sdk/tools/check-standards.ts src",
    "db:check": "tsx node_modules/@primebrick/dal-pg/dist/cli/primebrick-db.js check --registry src/domain/entities/registry.ts --snapshot db-meta/snapshot-entities.json"
  },
  "dependencies": {
    "@modelcontextprotocol/express": "2.0.0-beta.4",
    "@modelcontextprotocol/node": "2.0.0-beta.4",
    "@modelcontextprotocol/server": "2.0.0-beta.4",
    "@primebrick/dal-pg": "file:../primebrick-dal-v3",
    "@primebrick/sdk": "workspace:*",
    "casdoor-nodejs-sdk": "1.34.0",
    "cookie-parser": "1.4.7",
    "cors": "2.8.6",
    "dotenv": "17.4.2",
    "exceljs": "4.4.0",
    "express": "4.22.2",
    "handlebars": "4.7.9",
    "hono": "4.11.4",
    "jose": "6.2.3",
    "nats": "2.29.3",
    "openid-client": "6.8.4",
    "pg": "8.22.0",
    "redis": "6.1.0",
    "reflect-metadata": "0.2.2",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/cookie-parser": "1.4.10",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/node": "24.13.3",
    "@types/pg": "8.20.0",
    "tsx": "4.23.0",
    "typescript": "6.0.3",
    "vite": "8.1.5",
    "vitest": "4.1.10"
  }
}
